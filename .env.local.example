# Copy this file to .env.local (already gitignored) and fill in the values
# from your Supabase project: Project Settings → API.
#
# NEXT_PUBLIC_* vars are exposed to the browser — that's expected for the URL
# and anon key, which are meant to be public and are protected by the RLS
# policies in supabase/migrations/0001_init.sql, not by secrecy.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely. Keep it
# server-side only — never prefix it with NEXT_PUBLIC_, never commit it.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
