# iOS
#
# NivaraPatient.xcodeproj IS committed (not ignored) — Xcode Cloud's
# ci_post_clone.sh/XcodeGen regeneration step proved unreliable (a known,
# unresolved Xcode Cloud issue, not specific to this repo), so the
# generated project file is checked in directly instead. project.yml
# remains the source of truth for local dev — regenerate with
# `xcodegen generate` and re-commit the result after changing it.
# xcuserdata/ (per-user window layout, breakpoints, etc.) stays ignored
# regardless, since none of that is meant to be shared.
ios/**/DerivedData/
ios/**/xcuserdata/
ios/**/.build/
# SupabaseConfig.swift IS committed (with safe placeholder values only —
# see its doc comment) so a fresh checkout / Xcode Cloud has a real file
# to compile against. Fill in real values locally, then run
# `git update-index --skip-worktree` on it so your keys never get staged.
